<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 301 Redirect /index.php to https://drsujitchowdhary.com/
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php\ HTTP/
    RewriteRule ^index\.php$ https://drsujitchowdhary.com/ [R=301,L]

    # 301 Redirect deleted undescended testis service to homepage
    RewriteRule ^service/undescended-testis(\.php)?$ https://drsujitchowdhary.com/ [R=301,L]
    RewriteRule ^service-undescended-testis(\.(php|html))?$ https://drsujitchowdhary.com/ [R=301,L]

    # 301 Redirect service pages using RewriteRule (Apache mod_rewrite compatible)
    RewriteRule ^service-absent-testis(\.php)?$ https://drsujitchowdhary.com/service/absent-testis.php [R=301,L]
    RewriteRule ^service-adrenal-tumor(\.php)?$ https://drsujitchowdhary.com/service/adrenal-tumor.php [R=301,L]
    RewriteRule ^service-anorectal-malformation(\.php)?$ https://drsujitchowdhary.com/service/anorectal-malformation.php [R=301,L]
    RewriteRule ^service-biliary-atresia(\.php)?$ https://drsujitchowdhary.com/service/biliary-atresia.php [R=301,L]
    RewriteRule ^service-choledochal-cyst(\.php)?$ https://drsujitchowdhary.com/service/choledochal-cyst.php [R=301,L]
    RewriteRule ^service-duplex-renal-system(\.php)?$ https://drsujitchowdhary.com/service/duplex-renal-system.php [R=301,L]
    RewriteRule ^service-exstrophy-epispadias(\.php)?$ https://drsujitchowdhary.com/service/exstrophy-epispadias.php [R=301,L]
    RewriteRule ^service-hernia-hydrocele(\.php)?$ https://drsujitchowdhary.com/service/hernia-hydrocele.php [R=301,L]
    RewriteRule ^service-hirschsprung(\.php)?$ https://drsujitchowdhary.com/service/hirschsprung.php [R=301,L]
    RewriteRule ^service-hydronephrosis(\.php)?$ https://drsujitchowdhary.com/service/hydronephrosis.php [R=301,L]
    RewriteRule ^service-hypospadias(\.php)?$ https://drsujitchowdhary.com/service/hypospadias.php [R=301,L]
    RewriteRule ^service-neuropathic-bladder(\.php)?$ https://drsujitchowdhary.com/service/neuropathic-bladder.php [R=301,L]
    RewriteRule ^service-paediatric-gi(\.php)?$ https://drsujitchowdhary.com/service/paediatric-gi.php [R=301,L]
    RewriteRule ^service-pediatric-gi-surgery(\.php)?$ https://drsujitchowdhary.com/service/pediatric-gi-surgery.php [R=301,L]
    RewriteRule ^service-pediatric-oncosurgery(\.php)?$ https://drsujitchowdhary.com/service/pediatric-oncosurgery.php [R=301,L]
    RewriteRule ^service-pediatric-robotic-surgery(\.php)?$ https://drsujitchowdhary.com/service/pediatric-robotic-surgery.php [R=301,L]
    RewriteRule ^service-pediatric-stone-disease(\.php)?$ https://drsujitchowdhary.com/service/pediatric-stone-disease.php [R=301,L]
    RewriteRule ^service-pediatric-tumors(\.php)?$ https://drsujitchowdhary.com/service/pediatric-tumors.php [R=301,L]
    RewriteRule ^service-pediatric-urodynamics(\.php)?$ https://drsujitchowdhary.com/service/pediatric-urodynamics.php [R=301,L]
    RewriteRule ^service-phimosis(\.php)?$ https://drsujitchowdhary.com/service/phimosis.php [R=301,L]
    RewriteRule ^service-pujo(\.php)?$ https://drsujitchowdhary.com/service/pujo.php [R=301,L]
    RewriteRule ^service-puv(\.php)?$ https://drsujitchowdhary.com/service/puv.php [R=301,L]
    RewriteRule ^service-renal-tumor(\.php)?$ https://drsujitchowdhary.com/service/renal-tumor.php [R=301,L]
    RewriteRule ^service-thoracoscopic-surgery(\.php)?$ https://drsujitchowdhary.com/service/thoracoscopic-surgery.php [R=301,L]
    RewriteRule ^service-uti(\.php)?$ https://drsujitchowdhary.com/service/uti.php [R=301,L]
    RewriteRule ^service-vesicoureteric-reflux(\.php)?$ https://drsujitchowdhary.com/service/vesicoureteric-reflux.php [R=301,L]
    RewriteRule ^service-voiding-dysfunction(\.php)?$ https://drsujitchowdhary.com/service/voiding-dysfunction.php [R=301,L]

    # Catch-all pattern for old service-name.php, service-name.html, or service-name to /service/name.php
    RewriteRule ^service-([a-z0-9-]+)(\.(php|html))?$ https://drsujitchowdhary.com/service/$1.php [R=301,L]

    # 301 Redirect directives (mod_alias fallback)
    Redirect 301 /service-absent-testis.php https://drsujitchowdhary.com/service/absent-testis.php
    Redirect 301 /service-adrenal-tumor.php https://drsujitchowdhary.com/service/adrenal-tumor.php
    Redirect 301 /service-anorectal-malformation.php https://drsujitchowdhary.com/service/anorectal-malformation.php
    Redirect 301 /service-biliary-atresia.php https://drsujitchowdhary.com/service/biliary-atresia.php
    Redirect 301 /service-choledochal-cyst.php https://drsujitchowdhary.com/service/choledochal-cyst.php
    Redirect 301 /service-duplex-renal-system.php https://drsujitchowdhary.com/service/duplex-renal-system.php
    Redirect 301 /service-exstrophy-epispadias.php https://drsujitchowdhary.com/service/exstrophy-epispadias.php
    Redirect 301 /service-hernia-hydrocele.php https://drsujitchowdhary.com/service/hernia-hydrocele.php
    Redirect 301 /service-hirschsprung.php https://drsujitchowdhary.com/service/hirschsprung.php
    Redirect 301 /service-hydronephrosis.php https://drsujitchowdhary.com/service/hydronephrosis.php
    Redirect 301 /service-hypospadias.php https://drsujitchowdhary.com/service/hypospadias.php
    Redirect 301 /service-neuropathic-bladder.php https://drsujitchowdhary.com/service/neuropathic-bladder.php
    Redirect 301 /service-paediatric-gi.php https://drsujitchowdhary.com/service/paediatric-gi.php
    Redirect 301 /service-pediatric-gi-surgery.php https://drsujitchowdhary.com/service/pediatric-gi-surgery.php
    Redirect 301 /service-pediatric-oncosurgery.php https://drsujitchowdhary.com/service/pediatric-oncosurgery.php
    Redirect 301 /service-pediatric-robotic-surgery.php https://drsujitchowdhary.com/service/pediatric-robotic-surgery.php
    Redirect 301 /service-pediatric-stone-disease.php https://drsujitchowdhary.com/service/pediatric-stone-disease.php
    Redirect 301 /service-pediatric-tumors.php https://drsujitchowdhary.com/service/pediatric-tumors.php
    Redirect 301 /service-pediatric-urodynamics.php https://drsujitchowdhary.com/service/pediatric-urodynamics.php
    Redirect 301 /service-phimosis.php https://drsujitchowdhary.com/service/phimosis.php
    Redirect 301 /service-pujo.php https://drsujitchowdhary.com/service/pujo.php
    Redirect 301 /service-puv.php https://drsujitchowdhary.com/service/puv.php
    Redirect 301 /service-renal-tumor.php https://drsujitchowdhary.com/service/renal-tumor.php
    Redirect 301 /service-thoracoscopic-surgery.php https://drsujitchowdhary.com/service/thoracoscopic-surgery.php
    Redirect 301 /service-uti.php https://drsujitchowdhary.com/service/uti.php
    Redirect 301 /service-vesicoureteric-reflux.php https://drsujitchowdhary.com/service/vesicoureteric-reflux.php
    Redirect 301 /service-voiding-dysfunction.php https://drsujitchowdhary.com/service/voiding-dysfunction.php

    # Redirect old/error blog URLs to the main blog page
    RewriteRule ^blogs/?$ https://drsujitchowdhary.com/ [R=301,L]
    RewriteRule ^blogs/.+$ https://drsujitchowdhary.com/blog.php [R=301,L]
    RedirectMatch 301 ^/blogs/.+$ https://drsujitchowdhary.com/blog.php

    # Redirect old /pin/ URLs and query string ?pin/* to homepage
    RewriteCond %{QUERY_STRING} ^pin/ [NC]
    RewriteRule ^index\.php$ https://drsujitchowdhary.com/? [R=301,L]
    RewriteRule ^pin/.*$ https://drsujitchowdhary.com/ [R=301,L]
    RedirectMatch 301 ^/pin/.*$ https://drsujitchowdhary.com/

    # -------------------------------------------------------------
    # 301 Redirect Rules (Additional Legacy & Spam Cleanup)
    # -------------------------------------------------------------

    # Redirect specific legacy URLs to gallery.php
    RewriteRule ^service/gallery\.php$ https://drsujitchowdhary.com/gallery.php [R=301,L,NC]
    RewriteRule ^EHBA\.php/gallery\.php$ https://drsujitchowdhary.com/gallery.php [R=301,L,NC]
    RewriteRule ^case-study\.php$ https://drsujitchowdhary.com/gallery.php [R=301,L,NC]

    # Redirect legacy tumor URLs to pediatric-tumours page (/service/pediatric-tumors.php)
    RewriteRule ^pediatric-tumours\.php(/.*)?$ https://drsujitchowdhary.com/service/pediatric-tumors.php [R=301,L,NC]
    RewriteRule ^Wilms'?s-tumour\.php(/.*)?$ https://drsujitchowdhary.com/service/pediatric-tumors.php [R=301,L,NC]
    RewriteRule ^Renal-Tumor\.php(/.*)?$ https://drsujitchowdhary.com/service/pediatric-tumors.php [R=301,L,NC]

    # Redirect double service prefix (service/service/...) and service index to homepage
    RewriteRule ^service/service/.*$ https://drsujitchowdhary.com/ [R=301,L,NC]
    RewriteRule ^service/index\.php$ https://drsujitchowdhary.com/ [R=301,L,NC]

    # Redirect foreign / spam / old CMS directory paths to homepage
    RewriteRule ^(shop|contents|toyu|cate-[0-9-]+|information|reserve)(/.*)?$ https://drsujitchowdhary.com/ [R=301,L,NC]
    RewriteRule ^index\.php/(shop|contents|toyu|cate-[0-9-]+|information|reserve)(/.*)?$ https://drsujitchowdhary.com/ [R=301,L,NC]

    # Redirect legacy clinic & landing pages to homepage
    RewriteRule ^(children'?s-hospital-urology-clinic|kids-urologist-in-delhi|paediatric-urology-clinic|paediatric-urologist-in-delhi|paediatric-urology-surgery|best-paediatric-urologist)(/.*)?$ https://drsujitchowdhary.com/ [R=301,L,NC]

    # Redirect compound .php/ URLs to homepage
    RewriteRule ^[A-Za-z0-9_'-]+\.php/.+$ https://drsujitchowdhary.com/ [R=301,L,NC]

    # Redirect legacy condition/procedure .php and .html files to homepage
    RewriteRule ^(Esophageal-Subtitution|Duplex-Pelvicalyceal|Pediatric-urodynamics|Biliary-Atresia|Robotic|Urology|Exstrophy-epispadias|Hirschsprung'?s-Disease|anorectal-malformation|Pediatric-Laparoscopy|EHBA|Pelvic-ureteric|Conjoined-twin-surgery|Circumcision|Pediatric-urology|Urinary-Tract|Thoracoscopic-surgery|Testis-undescended|International-Patients|Hypsopadias|Undescended-testis|Hernia-and-Hydrocele|Neuropathic-bladder|Testicular-Torsion|daycare-surgery|Antenatal-Hydronephrosis|Cholechodd-cyst|Hydronephrosis|Urinary-stone|Rectourethral-Fistula|Disorder-of-sexual-differentiation|Vesicoureteric)\.php$ https://drsujitchowdhary.com/ [R=301,L,NC]
    RewriteRule ^service-hirschsprung\.html$ https://drsujitchowdhary.com/ [R=301,L,NC]

    # Redirect legacy assets/reviews files (.xlsx, .xls, extensionless) to homepage
    RewriteRule ^assets/reviews(/.*)?$ https://drsujitchowdhary.com/ [R=301,L,NC]

    # 301 Redirect any other .html requests to .php equivalent
    RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
    RewriteRule ^ /%1.php [R=301,L]

    # Allow extensionless URLs to serve .php files
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# Disable browser caching for dynamic PHP pages
<IfModule mod_headers.c>
    <FilesMatch "\.(php|html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
